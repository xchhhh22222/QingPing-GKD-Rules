{
  "id": 20261023,
  "name": "Necy GKD · 开屏与广告补充（谨慎版）",
  "version": 3,
  "author": "Necy",
  "supportUri": "https://github.com/xchhhh22222/QingPing/tree/main/gkd",
  "checkUpdateUrl": "./necy-gkd.version.json5",
  "categories": [
    {
      "key": 0,
      "name": "开屏广告"
    },
    {
      "key": 1,
      "name": "全屏广告"
    },
    {
      "key": 2,
      "name": "局部广告"
    }
  ],
  "globalGroups": [
    {
      "key": 99001,
      "name": "开屏广告-繁体/英文补漏（手动启用）",
      "desc": "只作为既有开屏规则未命中时的补救；与其他订阅的全局跳过规则可能重复。",
      "enable": false,
      "fastQuery": true,
      "matchTime": 10000,
      "resetMatch": "app",
      "actionMaximum": 1,
      "actionCd": 1500,
      "disableIfAppGroupMatch": "开屏广告",
      "rules": [
        {
          "key": 1,
          "matches": "[text*=\"跳過\"][text.length<10][visibleToUser=true]"
        },
        {
          "key": 2,
          "matches": "[text^=\"Skip Ad\"][text.length<14][visibleToUser=true]"
        },
        {
          "key": 3,
          "matches": "[desc*=\"跳過\"][desc.length<10][visibleToUser=true]"
        }
      ]
    }
  ],
